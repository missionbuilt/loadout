{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/missionbuilt/ironstack/schema/workout.schema.json",
  "title": "Ironstack Workout Log",
  "description": "One training session. This file is the source of truth; the indexer explodes it into workout-sessions, workout-sets, and workout-notes documents.",
  "type": "object",
  "required": [
    "session",
    "exercises"
  ],
  "additionalProperties": false,
  "properties": {
    "session": {
      "type": "object",
      "required": [
        "date",
        "session_id"
      ],
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string",
          "description": "Unique id, required. Conventionally the date; add a suffix for a second session in one day (e.g. 2026-09-01-pm). It was optional, and session_key() fell back to the date, so a second dated-only session on a day already carrying one silently replaced it - nine dates in this repo carry two sessions.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(-[a-z0-9-]+)?$"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "start_time": {
          "type": "string",
          "description": "Local start time, HH:MM (24h).",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "timezone": {
          "type": "string",
          "description": "IANA timezone, e.g. America/New_York."
        },
        "duration_min": {
          "type": "number",
          "minimum": 0
        },
        "time_of_day": {
          "enum": [
            "morning",
            "midday",
            "evening",
            "night"
          ]
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "Coarse by design: town or city level. Travel sessions use the city you're in."
            },
            "geo": {
              "type": "object",
              "description": "Optional coarse coordinates (town-level). Never required.",
              "required": [
                "lat",
                "lon"
              ],
              "additionalProperties": false,
              "properties": {
                "lat": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "lon": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              }
            },
            "travel": {
              "type": "boolean",
              "description": "True when training away from the home gym."
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "temp_f": {
              "type": "number"
            },
            "humidity_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "conditions": {
              "type": "string"
            },
            "wind": {
              "type": "string"
            },
            "setting": {
              "type": "string",
              "description": "e.g. 'garage doors open, music loud'"
            }
          }
        },
        "program": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "block": {
              "type": "string"
            },
            "day": {
              "type": "integer",
              "minimum": 1
            },
            "total_days": {
              "type": "integer",
              "minimum": 1
            },
            "phase": {
              "enum": [
                "hypertrophy",
                "strength",
                "peaking"
              ],
              "description": "Training phase this session belongs to. Drives phase coloring in the dashboards."
            },
            "week": {
              "type": "integer",
              "minimum": 1,
              "description": "Program week number."
            },
            "meet_date": {
              "type": "string",
              "format": "date",
              "description": "The meet this block is building toward. Powers the days-to-meet tile."
            }
          }
        },
        "gear_notes": {
          "type": "string"
        },
        "wrap_up": {
          "type": "string",
          "description": "How the session felt, in the lifter's words."
        },
        "watch_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "type": "object",
          "description": "Optional daily companions. Dashboards hide these panels when empty.",
          "additionalProperties": false,
          "properties": {
            "bodyweight_lb": {
              "type": "number",
              "minimum": 0
            },
            "sleep_hrs": {
              "type": "number",
              "minimum": 0,
              "maximum": 24
            }
          }
        },
        "source": {
          "type": "string",
          "description": "Where the log came from when it wasn't logged live \u2014 e.g. 'juggernautai-export'. Absent means logged in the moment."
        }
      }
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "category",
          "sets"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "enum": [
              "prep",
              "main",
              "accessory"
            ]
          },
          "equipment": {
            "type": "string"
          },
          "emphasis": {
            "type": "string",
            "description": "Intent, e.g. 'feet shoulder width for max quad emphasis'."
          },
          "gear": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Default gear for this exercise's sets; a set's own gear list overrides."
          },
          "sets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "reps"
              ],
              "additionalProperties": false,
              "properties": {
                "set_number": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Defaults to position in the array."
                },
                "set_type": {
                  "enum": [
                    "prep",
                    "working"
                  ],
                  "default": "working"
                },
                "weight_lb": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Total load. 0 for bodyweight."
                },
                "reps": {
                  "type": "number",
                  "minimum": 0
                },
                "rep_unit": {
                  "enum": [
                    "reps",
                    "walks",
                    "seconds"
                  ],
                  "default": "reps"
                },
                "distance_ft": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Per rep, for carries (rep_unit: walks)."
                },
                "load_type": {
                  "enum": [
                    "external",
                    "bodyweight"
                  ],
                  "default": "external"
                },
                "rpe": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10,
                  "description": "Single effort scale. Convert reps-in-reserve: RPE = 10 - RIR."
                },
                "gear": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "notes": {
                  "type": "string"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "weight_each_lb": {
                  "type": "number",
                  "description": "Load in each hand; weight_lb stays the total."
                },
                "each_side": {
                  "type": "boolean",
                  "description": "reps are per side, not combined."
                },
                "scheme": {
                  "type": "string",
                  "description": "Ladders and other rep schemes: '6,5,4,3,2 + hold'."
                },
                "cardio": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Conditioning numbers as fields rather than a sentence.",
                  "properties": {
                    "distance_mi": {
                      "type": "number"
                    },
                    "calories": {
                      "type": "number"
                    },
                    "avg_watts": {
                      "type": "number"
                    },
                    "peak_watts": {
                      "type": "number"
                    },
                    "cadence_rpm": {
                      "type": "number"
                    },
                    "peak_mph": {
                      "type": "number"
                    },
                    "avg_hr": {
                      "type": "number"
                    },
                    "max_hr": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "equipment_items": {
            "type": "array",
            "description": "Structured equipment, expanded from @ids in config/equipment.json. `equipment` stays the readable line.",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "weight_lb": {
                  "type": "number"
                },
                "brand": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "description": "Mindset and observation notes, in session order.",
      "items": {
        "type": "object",
        "required": [
          "phase",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "phase": {
            "enum": [
              "pre",
              "prep",
              "exercise",
              "wrap-up"
            ]
          },
          "exercise": {
            "type": "string"
          },
          "set_number": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "From the taxonomy where possible: felt-strong, motivation, soreness, body-awareness:<area>, grip, asymmetry:left, asymmetry:right, cue, technique, gear-note, environment, experiment, fatigue, travel."
          }
        }
      }
    }
  }
}
